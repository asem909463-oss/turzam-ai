{
  "name": "turzam-ai",
  "version": "1.3.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:edge": "node --experimental-strip-types --no-warnings --test supabase/functions/tests/*.test.ts",
    "check:edge": "deno check supabase/functions/chat/index.ts supabase/functions/delete-account/index.ts && deno lint supabase/functions",
    "check": "npm run typecheck && npm run test:edge",
    "pin": "node scripts/pin-deps.mjs",
    "check:pinned": "node scripts/pin-deps.mjs --check",
    "check:env": "node scripts/check-env.mjs",
    "check:secrets": "node scripts/check-env.mjs --secrets",
    "test:quota": "bash supabase/tests/quota_concurrency.sh"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "*",
    "@expo-google-fonts/space-grotesk": "*",
    "@expo/vector-icons": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "*",
    "expo-audio": "*",
    "expo-clipboard": "*",
    "expo-constants": "*",
    "expo-document-picker": "*",
    "expo-file-system": "*",
    "expo-font": "*",
    "expo-haptics": "*",
    "expo-image-picker": "*",
    "expo-linear-gradient": "*",
    "expo-linking": "*",
    "expo-print": "*",
    "expo-router": "*",
    "expo-sharing": "*",
    "expo-speech": "*",
    "expo-store-review": "*",
    "expo-splash-screen": "*",
    "expo-status-bar": "*",
    "react": "19.3.0",
    "react-native": "*",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "*",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "*",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
