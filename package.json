{
  "name": "turzam-ai",
  "version": "1.3.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:edge": "node --experimental-strip-types --no-warnings --test supabase/functions/tests/*.test.ts",
    "check:edge": "deno check supabase/functions/chat/index.ts supabase/functions/delete-account/index.ts && deno lint supabase/functions",
    "check": "npm run typecheck && npm run test:edge",
    "pin": "node scripts/pin-deps.mjs",
    "check:pinned": "node scripts/pin-deps.mjs --check",
    "check:env": "node scripts/check-env.mjs",
    "check:secrets": "node scripts/check-env.mjs --secrets",
    "test:quota": "bash supabase/tests/quota_concurrency.sh"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "0.4.1",
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "expo": "58.0.22",
    "expo-audio": "58.0.11",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.14",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-haptics": "58.0.7",
    "expo-image-picker": "58.0.10",
    "expo-linear-gradient": "58.0.3",
    "expo-linking": "58.0.15",
    "expo-print": "58.0.8",
    "expo-router": "58.0.29",
    "expo-sharing": "58.0.21",
    "expo-speech": "58.0.3",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-store-review": "58.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-url-polyfill": "2.0.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
