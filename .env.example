# ------------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in the required values.
# Supabase's anon key and RevenueCat's public iOS SDK key are safe in the app.
# The RevenueCat secret API key belongs only in supabase/.env.
# The anon key only works
# together with the Row Level Security rules in supabase/schema.sql.
# ------------------------------------------------------------------

# Supabase dashboard -> Project Settings -> API -> "Project URL"
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard -> Project Settings -> API -> "anon public" key
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# RevenueCat dashboard -> project API keys -> public iOS key (required for native purchases)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# Must match App Store Connect and RevenueCat product identifiers.
EXPO_PUBLIC_TURZAM_PLUS_PRODUCT_ID=turzam_plus_monthly
EXPO_PUBLIC_TURZAM_PRO_PRODUCT_ID=turzam_pro_monthly
# Optional display fallback; actual StoreKit localized product prices take precedence.
EXPO_PUBLIC_TURZAM_PLUS_PRICE=$5.99
EXPO_PUBLIC_TURZAM_PRO_PRICE=$11.99

# Optional: a contact email shown in the Terms, Privacy and Cookie policies inside the app.
EXPO_PUBLIC_SUPPORT_EMAIL=

# ------------------------------------------------------------------
# DO NOT put AI provider keys or the RevenueCat secret API key in this file.
# Those server secrets live ONLY on Supabase (see supabase/.env.example).
# DO NOT paste the Supabase "service_role" key anywhere, not even here. You never handle it:
# Supabase gives it to the delete-account function by itself while it runs.
#
# Check this file any time (prints no secrets):  npm run check:env
# ------------------------------------------------------------------
