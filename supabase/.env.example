# ------------------------------------------------------------------
# GEMINI KEY GOES HERE (server side only).
# Copy this file to "supabase/.env", paste your key, then run:
#   npx supabase secrets set --env-file supabase/.env
# The file supabase/.env is git-ignored and never ships in the app.
# ------------------------------------------------------------------

# Get it at https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE-YOUR-GEMINI-API-KEY-HERE

# Optional: which Gemini model to use. Change it any time, no app update needed.
GEMINI_MODEL=gemini-3.8-flash
